# Copy this file to .env and fill in real values. Never commit .env.

# Google Geocoding API key (fallback geocoder — only used when Census fails
# or returns a low-confidence match). Requires billing enabled on the
# Google Cloud project. https://console.cloud.google.com/apis/credentials
GOOGLE_GEOCODING_API_KEY=your_google_api_key_here

# Census Bureau geocoder benchmark name. Census periodically updates the
# concrete benchmark identifiers; "Public_AR_Current" is Census's own
# stable alias for "whatever is current," so it should not need to change,
# but it is kept configurable per the research brief rather than assumed
# permanent. The app also fetches /geocoder/benchmarks at startup to
# confirm this value is still valid and to log a warning if not.
CENSUS_BENCHMARK=Public_AR_Current

# Default payment-factor multiplier (allowed-charge-to-paid-amount ratio).
# This is a PLANNING ESTIMATE, not an official CMS-published constant.
# Exposed here so it can be tuned without touching code. See
# src/bonus/calculate.js for details.
DEFAULT_PAYMENT_FACTOR=1.0

# Port for the optional local reference server (server.js). Not required
# if you wire src/api/handler.js into another host (e.g. Bolt.new).
PORT=3000
